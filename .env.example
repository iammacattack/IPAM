# Run scripts/Initialize-IpamEnv.ps1 to generate real values; it also adds anything missing later.
POSTGRES_PASSWORD=[DB-PASSWORD]
IPAM_BOOTSTRAP_API_KEY=ipam_[8-HEX-PREFIX]_[SECRET-32+-CHARS]
IPAM_SECRET_KEY=[32-RANDOM-BYTES-BASE64URL]
IPAM_ADMIN_USERNAME=admin
IPAM_ADMIN_PASSWORD=[FIRST-ADMIN-PASSWORD]
IPAM_PORT=8820
